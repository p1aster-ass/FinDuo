# Populate .env.local with `neon env pull` after linking the project.
# Server-side credentials only. Never prefix database URLs with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@POOLED_HOST/DATABASE?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
NEON_BRANCH=YOUR_NEON_BRANCH_NAME
NEON_AUTH_BASE_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth
NEON_AUTH_JWKS_URL=https://YOUR_NEON_AUTH_HOST/neondb/auth/.well-known/jwks.json

# Public Auth endpoint only. Vite expands this from the Neon-managed value.
VITE_NEON_AUTH_URL=${NEON_AUTH_BASE_URL}

# Public Data API (PostgREST) endpoint. Authorized with the user's Neon Auth JWT.
VITE_NEON_DATA_API_URL=https://YOUR_NEON_DATA_API_HOST/neondb/rest/v1
